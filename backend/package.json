{
  "name": "nexcv-backend-express",
  "version": "0.1.0",
  "description": "NexCV Backend (Express.js + Prisma/PostgreSQL) — migrated from NestJS",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node prisma/seed.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v && docker compose up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.9",
    "openai": "^6.35.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  }
}
