# ============================================================
# NexCV Backend (Express) Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── PostgreSQL (Prisma) ──────────────────────────────────────
# Matches docker-compose.yml: `docker compose up -d` starts the DB server.
DATABASE_URL=postgresql://nexcvd:nexcvd_secret@localhost:5442/nexcvd?schema=public

# ─── JWT Authentication ──────────────────────────────────────
# Generate a random secret key: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_this_in_production
# Token lifetime. NOTE: the app reads JWT_EXPIRES_IN (default '7d');
# JWT_EXPIRES is kept only for backward compatibility and is ignored.
JWT_EXPIRES_IN=7d
JWT_EXPIRES=30d

# ─── Gemini API (for CV Scoring) ──────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
# If no key is provided, it falls back to the local knowledge base engine.
GEMINI_API_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────
# Used for sending password reset emails.
# For Gmail: use smtp.gmail.com, port 587, and an App Password.
# For Mailtrap (dev): use sandbox.smtp.mailtrap.io, port 2525.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexCV <noreply@nexcv.vn>

# ─── Frontend URL ─────────────────────────────────────────────
# Used to build the password reset link in emails
FRONTEND_URL=http://localhost:5173

# ─── Server ───────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=*
NODE_ENV=development
